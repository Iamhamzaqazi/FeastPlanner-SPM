@page "/ResetPassword"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using MudBlazor

<MudThemeProvider />

<div class="login-wrapper animate-fade">
    <MudPaper Elevation="8" Class="login-card">

        <MudGrid Class="text-center">

            <!-- Title -->
            <MudItem xs="12" Class="mb-2">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    Reset <span class="text-warning">Password</span>
                </MudText>

                <!-- Step instructions -->
                @if (!IsSent && IsVerified == false)
                {
                    <MudText Typo="Typo.body2" Class="text-muted mt-1">
                        Enter your registered email to receive an OTP code.
                    </MudText>
                }
                else if (IsSent && IsVerified == false)
                {
                    <MudText Typo="Typo.body2" Class="text-muted mt-1">
                        Check your inbox for the OTP code and enter it below.
                    </MudText>
                }
                else if (IsVerified)
                {
                    <MudText Typo="Typo.body2" Class="text-muted mt-1">
                        Enter a new strong password for your account.
                    </MudText>
                }
            </MudItem>

            <!-- EMAIL FORM -->
            <MudItem xs="12" Class="mt-3">
                @if (!IsSent && IsVerified == false)
                {
                    <MudForm @ref="formEmail" @bind-IsValid="@successEmail" @bind-Errors="@errors">
                        <MudTextField T="string"
                                      @bind-Value="@Email"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Required="true"
                                      Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})"
                                      RequiredError="Email is required"
                                      FullWidth="true"
                                      Immediate="true" />

                        <MudButton FullWidth="true"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="mt-3 login-btn"
                                   Disabled="@loading"
                                   OnClick="SentCode">

                            @if (loading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ms-2">Sending...</span>
                            }
                            else
                            {
                                <MudText>Send Code</MudText>
                            }
                        </MudButton>
                    </MudForm>
                }

                <!-- OTP CODE -->
                @if (IsSent && IsVerified == false)
                {
                    <MudTextField T="string"
                                  @bind-Value="@Code"
                                  Label="Verification Code"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Password"
                                  MaxLength="4"
                                  Required="true"
                                  RequiredError="Code is required"
                                  FullWidth="true"
                                  Immediate="true" />

                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mt-3 login-btn"
                               Disabled="@loading"
                               OnClick="VerifyCode">
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Verifying...</span>
                        }
                        else
                        {
                            <MudText>Verify Code</MudText>
                        }
                    </MudButton>
                }

                <!-- NEW PASSWORD -->
                @if (IsVerified)
                {
                    <MudForm @ref="formPassword" @bind-IsValid="@successPassword" @bind-Errors="@errors">

                        <MudTextField T="string"
                                      @bind-Value="@NewPassword"
                                      Label="New Password"
                                      @ref="pwField1"
                                      Variant="Variant.Outlined"
                                      InputType="@PasswordInput"
                                      Adornment="Adornment.End"
                                      OnAdornmentClick="ShowPassword"
                                      AdornmentIcon="@PasswordInputIcon"
                                      Required="true"
                                      RequiredError="New Password is required"
                                      FullWidth="true"
                                      Immediate="true" />

                        <MudTextField T="string"
                                      Label="Confirm Password"
                                      Variant="Variant.Outlined"
                                      InputType="@PasswordInput"
                                      Required="true"
                                      RequiredError="Confirm Password is required"
                                      Validation="@(new Func<string, string>(PasswordMatch))"
                                      Adornment="Adornment.End"
                                      OnAdornmentClick="ShowPassword"
                                      AdornmentIcon="@PasswordInputIcon"
                                      FullWidth="true"
                                      Immediate="true"
                                      Class="mt-2" />

                        <MudButton FullWidth="true"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="mt-3 login-btn"
                                   Disabled="@loading"
                                   OnClick="ChangePassword">
                            @if (loading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ms-2">Saving...</span>
                            }
                            else
                            {
                                <MudText>Change Password</MudText>
                            }
                        </MudButton>

                    </MudForm>
                }
            </MudItem>

            <!-- Resend -->
            @if (IsSent && !IsVerified)
            {
                <MudItem xs="12" Class="mt-3">
                    <MudText Typo="Typo.caption" Class="text-muted">
                        Didn't receive the code?
                        <span class="text-primary fw-bold" style="cursor:pointer" @onclick="SentCode">
                            Resend Code
                        </span>
                    </MudText>
                </MudItem>
            }

            <!-- Footer -->
            <MudItem xs="12" Class="text-center mt-4 text-muted">
                <MudText Typo="Typo.caption">
                    © @DateTime.Now.Year Feast Planner — Recover Access Securely
                    <br />
                    <MudLink Href="#" Class="text-decoration-underline">Terms of Service</MudLink>
                </MudText>
            </MudItem>

        </MudGrid>
    </MudPaper>
</div>
