@page "/PasswordSetting"
@using MudBlazor

<PageTitle>Password Setting</PageTitle>

<AuthorizeView>
    <Authorized>

        <div class="dashboard-wrapper">
            <MudContainer MaxWidth="MaxWidth.False" Class="p-2">

                <!-- HEADER -->
                <MudItem xs="12" Class="mb-3">
                    <div class="dashboard-header fade-in">
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            <span class="text-primary">Password Setting</span>
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Title="Refresh"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       @onclick="Refresh" />
                    </div>
                </MudItem>

                <!-- FORM -->
                <MudGrid Justify="Justify.Center">
                    <MudItem xs="12" sm="8" md="6" lg="5">
                        <MudForm @ref="formUser" @bind-IsValid="@successUser" @bind-Errors="@errors">
                            <MudPaper Elevation="8" Class="dashboard-card animate-card p-4">

                                <MudGrid GutterSize="3">

                                    <MudItem xs="12">
                                        <MudText Typo="Typo.h6" Class="fw-bold text-primary">
                                            Setup New Password
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            Password must be minimum 8 characters long, include one uppercase, one lowercase and one digit.
                                        </MudText>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                      @bind-Value="@OldPassword"
                                                      Label="Old Password"
                                                      Variant="Variant.Outlined"
                                                      InputType="@PasswordInput"
                                                      Clearable="true"
                                                      MaxLength="150"
                                                      Immediate="true"
                                                      FullWidth="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@PasswordInputIcon"
                                                      OnAdornmentClick="ShowPassword"
                                                      Required="true"
                                                      RequiredError="Old password is required"
                                                      Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                      @bind-Value="@oModel.Password"
                                                      @ref="pwField1"
                                                      Label="New Password"
                                                      Variant="Variant.Outlined"
                                                      InputType="@PasswordInput"
                                                      Clearable="true"
                                                      MaxLength="150"
                                                      Immediate="true"
                                                      FullWidth="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@PasswordInputIcon"
                                                      OnAdornmentClick="ShowPassword"
                                                      Required="true"
                                                      RequiredError="New password is required"
                                                      Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                      Label="Confirm Password"
                                                      Variant="Variant.Outlined"
                                                      InputType="@PasswordInput"
                                                      Clearable="true"
                                                      MaxLength="150"
                                                      Immediate="true"
                                                      FullWidth="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@PasswordInputIcon"
                                                      OnAdornmentClick="ShowPassword"
                                                      Required="true"
                                                      RequiredError="Confirmation password required"
                                                      Validation="@(new Func<string,string>(PasswordMatch))" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudButton FullWidth="true"
                                                   Class="login-btn mt-2"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Disabled="@(loading)"
                                                   OnClick="SavePassword"
                                                   StartIcon="@Icons.Material.Sharp.Save">

                                            @if (loading)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                <span class="ms-2">Processing...</span>
                                            }
                                            else
                                            {
                                                <MudText>Change Password</MudText>
                                            }
                                        </MudButton>
                                    </MudItem>

                                </MudGrid>

                            </MudPaper>
                        </MudForm>
                    </MudItem>
                </MudGrid>

            </MudContainer>
        </div>

    </Authorized>
    <NotAuthorized>
        <NotAuthorizedPage />
    </NotAuthorized>
</AuthorizeView>
