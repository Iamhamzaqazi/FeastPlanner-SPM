                                            <MudText>Search</MudText>
                                        }
                                    </MudButton>
                                </MudItem>

                                @if (oFilterList.Count() > 0)
                                {
                                    <MudItem xs="12" sm="3" md="2">
                                        <MudButton FullWidth="true"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(loading)"
                                                   StartIcon="@Icons.Material.Sharp.Print"
                                                   OnClick="@Refresh">
                                            Print
                                        </MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="3" md="2">
                                        <MudButton FullWidth="true"
