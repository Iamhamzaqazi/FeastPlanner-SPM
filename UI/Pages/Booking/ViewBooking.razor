@page "/ViewBooking"
@using System.ComponentModel.DataAnnotations
@using System.Globalization;
@using MudBlazor

<PageTitle>View Booking</PageTitle>
<AuthorizeView Roles="View Booking">
    <Authorized>

        <div class="dashboard-wrapper">

            <MudContainer MaxWidth="MaxWidth.False" Class="p-2">

                <!-- HEADER -->
                <MudItem xs="12" Class="mb-3">
                    <div class="dashboard-header fade-in">
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            <span class="text-primary">View Booking</span>
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Title="Refresh"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       @onclick="Refresh" />
                    </div>
                    @* <MudText Typo="Typo.caption" Class="text-muted mt-1">
                        You can filter Expense details as per your <b>Desired</b>
                    </MudText> *@
                    <MudDivider Class="my-2" />
                    <MudLink Class="text-muted me-1" Underline="Underline.None">Booking / </MudLink>
                    <MudLink Href="/ViewBooking" Class="text-muted fw-bold" Underline="Underline.None">View Booking</MudLink>
                    <MudDivider Class="my-2" />
                </MudItem>

                <!-- FILTER FORM -->
                @* <MudItem xs="12" Class="mb-3">
                    <MudForm @ref="formUser" @bind-IsValid="@successUser" @bind-Errors="@errors">
                        <MudPaper Elevation="8" Class="dashboard-card animate-card p-4">
                            <MudGrid>

                                <MudItem xs="12" sm="6" md="4">
                                    <MudDateRangePicker @bind-DateRange="DateRange"
                                                        PickerVariant="PickerVariant.Inline"
                                                        DateFormat="MM/dd/yyyy"
                                                        Label="Date Range"
                                                        Variant="Variant.Outlined"
                                                        Required="true"
                                                        RequiredError="Date range required"
                                                        Adornment="Adornment.Start"
                                                        AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                                </MudItem>

                                <MudItem xs="12" sm="3" md="2">
                                    <MudButton FullWidth="true"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Disabled="@(loading)"
                                               StartIcon="@Icons.Material.Sharp.Search"
                                               OnClick="Search">
                                        @if (loading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Processing...</span>
                                        }
                                        else
