@using MudBlazor
@implements IDisposable

@if (DialogFor == "Signup")
{
    <MudDialog MaxWidth="MaxWidth.Small" Class="professional-dialog">
        <DialogContent>
            <div class="text-center p-4">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="fw-bold text-primary mb-2">Email Verification Required</MudText>
                <MudText Typo="Typo.body2" Class="text-muted">
                    An email has been initiated, please take some time to verify your identity.
                </MudText>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ConfirmSignUp"
                       StartIcon="@Icons.Material.Filled.Verified"
                       Class="login-btn">
                Verify
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@if (DialogFor == "Logout")
{
    <MudDialog MaxWidth="MaxWidth.Small" Class="premium-logout-dialog">
        <DialogContent>
            <!-- Professional Header -->
            <div class="logout-header">
                <div class="header-content text-center p-5">
                    <div class="logout-icon-container mb-4">
                        <div class="logout-icon-wrapper">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Large" Class="logout-icon" />
                        </div>
                    </div>
                    <MudText Typo="Typo.h5" Class="fw-bold text-white mb-2">Session Ending</MudText>
                    <MudText Typo="Typo.body1" Class="text-white opacity-90">
                        You're about to sign out of your account
                    </MudText>
                </div>
            </div>

            <!-- Dialog Content -->
            <div class="logout-content p-5">
                <div class="warning-section text-center mb-4">                    
                    <MudText Typo="Typo.body1" Class="text-muted mb-3">
                        Are you sure you want to <span class="text-primary fw-bold">logout</span> from your account?
                    </MudText>

                    <div class="session-info">
                        <MudChip Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="me-1" />
                            Active Session
                        </MudChip>
                    </div>
                </div>

                <MudDivider Class="my-4" />

                <!-- Action Buttons -->
                <div class="logout-actions d-flex justify-content-between">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="Cancel"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Large"
                               Class="cancel-btn">
                        Stay Signed In
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="LogoutConfirm"
                               StartIcon="@Icons.Material.Filled.ExitToApp"
                               Size="Size.Large"
                               Class="logout-confirm-btn">
                        Sign Out
                    </MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>
}

@if (DialogFor == "Notifications")
{
    <MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="premium-notifications-dialog">
       <DialogContent>
        <!-- Professional Header -->
        <div class="notifications-header">
            <div class="header-content p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="me-3">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6" Class="fw-bold text-white mb-0">Notifications Center</MudText>
                            <MudText Typo="Typo.caption" Class="text-white opacity-85">Stay updated with your alerts</MudText>
                        </div>
                    </div>
                    <MudBadge Color="Color.Warning" Content="@(oListUserAlert.Where(x => !x.MarkAsRead).Count())" Class="unread-count">
                        Unread
                    </MudBadge>
                </div>
            </div>
        </div>
            <MudTabs Color="Color.Primary" Position="Position.Top" Rounded="true" Class="premium-notification-tabs">
                <!-- Notifications Tab -->
                <MudTabPanel Text="Alerts" Icon="@Icons.Material.Filled.Notifications" 
                            BadgeColor="Color.Warning" 
                            BadgeData="@oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "Alert" && !x.MarkAsRead).Count()">
                    <div class="tab-content p-3">
                        @if (oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "Alert").Any())
                        {
                            foreach (var notification in oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "Alert"))
                            {
                                <MudCard Class="notification-card  mb-3" 
                                         Variant="Variant.Outlined" 
                                         OnClick="@(() => MarkasRead(notification.Id))">
                                    <MudCardContent Class="pa-4">
                                        <div class="d-flex align-items-start">
                                            <div class="notification-icon me-3">
                                                <MudAvatar Size="Size.Small" 
                                                          Color="@(notification.MarkAsRead ? Color.Secondary : Color.Primary)" 
                                                          Variant="Variant.Filled">
                                                    <MudIcon Icon="@Icons.Material.Filled.CircleNotifications" />
                                                </MudAvatar>
                                                @if (!notification.MarkAsRead)
                                                {
                                                    <div class="unread-indicator"></div>
                                                }
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <MudText Typo="Typo.body1" Class="fw-bold mb-1">@notification.Title</MudText>
                                                    <MudChip Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="me-1" />
                                                        @notification.TimeCalculate
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.body2" Class="text-muted mb-3">@notification.AlertMessage</MudText>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        @notification.AddedDt?.ToString("MMM dd, yyyy • h:mm tt")
                                                    </MudText>
                                                    @if (!notification.MarkAsRead)
                                                    {
                                                        <MudButton Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   Color="Color.Primary"
                                                                   OnClick="@(() => MarkasRead(notification.Id))"
                                                                   StartIcon="@Icons.Material.Filled.DoneAll"
                                                                   Class="mark-read-btn">
                                                            Mark Read
                                                        </MudButton>
                                                    }
                                                    else
                                                    {
                                                        <MudChip Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                                            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Class="me-1" />
                                                            Read
                                                        </MudChip>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <div class="empty-state text-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="text-muted mb-2">No Alerts</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">You're all caught up! No new alerts.</MudText>
                            </div>
                        }
                    </div>
                </MudTabPanel>

                <!-- Security Alerts Tab -->
                <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security" 
                            BadgeColor="Color.Error" 
                            BadgeData="@oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "SecurityAlert" && !x.MarkAsRead).Count()">
                    <div class="tab-content p-3">
                        @if (oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "SecurityAlert").Any())
                        {
                            foreach (var securityAlert in oListUserAlert.Where(x => x.UserKey == UserKey && x.Type == "SecurityAlert"))
                            {
                                <MudCard Class="security-card mb-3" 
                                         Variant="Variant.Outlined">
                                    <MudCardContent Class="pa-4">
                                        <div class="d-flex align-items-start">
                                            <div class="notification-icon me-3">
                                                <MudAvatar Size="Size.Small" 
                                                          Color="@(securityAlert.MarkAsRead ? Color.Secondary : Color.Error)" 
                                                          Variant="Variant.Filled">
                                                    <MudIcon Icon="@Icons.Material.Filled.Security" />
                                                </MudAvatar>
                                                @if (!securityAlert.MarkAsRead)
                                                {
                                                    <div class="unread-indicator security"></div>
                                                }
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <MudText Typo="Typo.body1" Class="fw-bold mb-1 text-error">@securityAlert.Title</MudText>
                                                    <MudChip Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                                        Security
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.body2" Class="text-muted mb-3">@securityAlert.AlertMessage</MudText>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="me-1 text-muted" />
                                                        <MudText Typo="Typo.caption" Class="text-muted">@securityAlert.TimeCalculate</MudText>
                                                    </div>
                                                    @if (!securityAlert.MarkAsRead)
                                                    {
                                                        <MudButton Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   OnClick="@(() => MarkasRead(securityAlert.Id))"
                                                                   StartIcon="@Icons.Material.Filled.DoneAll"
                                                                   Class="mark-read-btn">
                                                            Acknowledge
                                                        </MudButton>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <div class="empty-state text-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Large" Color="Color.Success" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="text-muted mb-2">No Security Issues</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">Your account is secure. No security alerts.</MudText>
                            </div>
                        }
                    </div>
                </MudTabPanel>

                <!-- Updates Tab -->
                <MudTabPanel Text="Updates" Icon="@Icons.Material.Filled.Update" 
                            BadgeColor="Color.Info" 
                            BadgeData="@oListUserAlert.Where(x => x.Type == "Updates" && !x.MarkAsRead).Count()">
                    <div class="tab-content p-3">
                        @if (oListUserAlert.Where(x => x.Type == "Updates" && !x.MarkAsRead).Any())
                        {
                            foreach (var update in oListUserAlert.Where(x => x.Type == "Updates" && !x.MarkAsRead))
                            {
                                <MudCard Class="update-card mb-3" Variant="Variant.Outlined">
                                    <MudCardContent Class="pa-4">
                                        <div class="d-flex align-items-start">
                                            <MudAvatar Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="me-3">
                                                <MudIcon Icon="@Icons.Material.Filled.Update" />
                                            </MudAvatar>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <MudText Typo="Typo.body1" Class="fw-bold mb-1 text-info">@update.Title</MudText>
                                                    <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                                        Update
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.body2" Class="text-muted mb-3">@update.AlertMessage</MudText>
                                                <div class="d-flex align-items-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="me-1 text-muted" />
                                                    <MudText Typo="Typo.caption" Class="text-muted">@update.TimeCalculate</MudText>
                                                </div>
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <div class="empty-state text-center py-6">
                                <MudIcon Icon="@Icons.Material.Filled.Upgrade" Size="Size.Large" Color="Color.Info" Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="text-muted mb-2">All Caught Up</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">You have the latest updates. Check back later for new features.</MudText>
                            </div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </DialogContent>
    </MudDialog>
}

@if (DialogFor == "Messages")
{
    <MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Class="premium-messages-dialog">
       <DialogContent>
        <!-- Professional Header -->
        <div class="messages-header">
            <div class="header-content p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="me-3">
                            <MudIcon Icon="@Icons.Material.Filled.Chat" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6" Class="fw-bold text-white mb-0">Messages</MudText>
                            <MudText Typo="Typo.caption" Class="text-white opacity-85">Your conversations</MudText>
                        </div>
                    </div>
                    <MudBadge Color="Color.Warning" 
                             Content="@(oListUserMessage.Where(x => x.FktoUserId == UserID && !x.MarkAsRead).Count())" 
                             Class="unread-count">
                        Unread
                    </MudBadge>
                </div>
            </div>
        </div>
            <div class="messages-container">
                @if (oListUserMessage.Any())
                {
                    foreach (var message in oListUserMessage.Take(10))
                    {
                        var unreadCount = oListUserMessage.Count(x => 
                            ((x.FkfromUserId == UserID && x.FktoUserId == message.FktoUserId) || 
                             (x.FktoUserId == UserID && x.FkfromUserId == message.FkfromUserId)) && 
                            !x.MarkAsRead);

                        <MudCard Class="message-card mb-2" 
                                 Variant="Variant.Outlined"
                                 OnClick="@(() => OpenChat())">
                            <MudCardContent Class="pa-4">
                                <div class="d-flex align-items-start">
                                    <div class="message-avatar me-3">
                                        <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Outlined">
                                            @if (message.FkfromUserId == UserID)
                                            {
                                                @message.FktoUserName?.FirstOrDefault()
                                            }
                                            else
                                            {
                                                @message.FkfromUserName?.FirstOrDefault()
                                            }
                                        </MudAvatar>
                                        @if (unreadCount > 0)
                                        {
                                            <div class="message-indicator"></div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <MudText Typo="Typo.body1" Class="fw-bold mb-0">
                                                @if (message.FkfromUserId == UserID)
                                                {
                                                    @message.FktoUserName
                                                }
                                                else
                                                {
                                                    @message.FkfromUserName
                                                }
                                            </MudText>
                                            <div class="d-flex align-items-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="me-1 text-muted" />
                                                <MudText Typo="Typo.caption" Class="text-muted">@message.TimeCalculate</MudText>
                                            </div>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="text-muted mb-2 message-preview">
                                            @if (unreadCount > 0)
                                            {
                                                <span class="fw-bold text-primary">@unreadCount new message@(unreadCount > 1 ? "s" : "")</span>
                                            }
                                            else
                                            {
                                                @message.Message
                                            }
                                        </MudText>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <MudChip Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                @message.AddedDt?.ToString("MMM dd")
                                            </MudChip>
                                            @if (message.FktoUserId == UserID && !message.MarkAsRead)
                                            {
                                                <MudButton Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => MarkasRead(message.Id))"
                                                           StartIcon="@Icons.Material.Filled.DoneAll"
                                                           Class="mark-read-btn">
                                                    Mark Read
                                                </MudButton>
                                            }
                                            else if (message.MarkAsRead)
                                            {
                                                <MudChip Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                                    <MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Class="me-1" />
                                                    Read
                                                </MudChip>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }

                    <!-- View All Button -->
                    <div class="text-center p-3">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="() => OpenChat()"
                                   StartIcon="@Icons.Material.Filled.Forum"
                                   Class="view-all-btn">
                            View All Conversations
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="empty-state text-center py-6">
                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                        <MudText Typo="Typo.h6" Class="text-muted mb-2">No Messages</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">Start a conversation to see messages here.</MudText>
                    </div>
                }
            </div>
        </DialogContent>
    </MudDialog>
}

@if (DialogFor == "Deactivate Profile" || DialogFor == "Deactivate Account")
{
    <MudDialog MaxWidth="MaxWidth.Small" Class="professional-dialog">
        <DialogContent>
            <div class="text-center p-4">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="fw-bold text-primary mb-2">
                    @(DialogFor == "Deactivate Profile" ? "Deactivate Profile" : "Deactivate Account")
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted mb-4">
                    Are you sure you want to <b class="text-primary">@(DialogFor == "Deactivate Profile" ? "deactivate your profile" : "deactivate your account")</b>?
                </MudText>

                <MudForm @ref="formUser" @bind-IsValid="@successUser" @bind-Errors="@errors" Class="mt-4">
                    <MudTextField T="string"
                                  @bind-Value="Password"
                                  MaxLength="150"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="@PasswordInput"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@PasswordInputIcon"
                                  OnAdornmentClick="ShowPassword"
                                  Required="true"
                                  RequiredError="Password is required!"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                                  FullWidth="true" />
                </MudForm>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="Cancel"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       Class="me-3">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       OnClick="@(DialogFor == "Deactivate Profile" ? DeactivateProfile : DeactivateAccount)"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Class="login-btn">
                Proceed
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@if (DialogFor == "Verify Email" || DialogFor == "Verify Contact")
{
    <MudDialog MaxWidth="MaxWidth.Small" Class="professional-dialog">
        <DialogContent>
            <div class="text-center p-4">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                    <MudIcon Icon="@(DialogFor == "Verify Email" ? Icons.Material.Filled.Email : Icons.Material.Filled.Phone)"
                             Size="Size.Large" />
                </MudAvatar>

                <MudText Typo="Typo.h6" Class="fw-bold text-primary mb-3">
                    @(DialogFor == "Verify Email" ? "Verify Email Address" : "Verify Contact Number")
                </MudText>

                @if (!IsSent)
                {
                    <MudText Typo="Typo.body2" Class="text-muted mb-4">
                        We will required your @(DialogFor == "Verify Email" ? "email" : "mobile no") to proceed.<br />
                        Once you clicked on sent code we will sent the verification code on your @(DialogFor == "Verify Email" ? "email" : "mobile").
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@loading"
                               OnClick="@(() => SentCode(""))"
                               StartIcon="@Icons.Material.Filled.Send"
                               FullWidth="true"
                               Class="login-btn mb-3">
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Processing</span>
                        }
                        else
                        {
                            <span>Sent Code</span>
                        }
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="text-muted mb-4">
                        Enter verification code that you received on your @(DialogFor == "Verify Email" ? "email" : "mobile phone") to proceed.<br />
                        And clicked on verify code.
                    </MudText>

                    <MudGrid Class="mb-4">
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          @bind-Value="@VerificationCode"
                                          Label="Verification Code"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Text"
                                          Required="true"
                                          RequiredError="Code required"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Password"
                                          FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@loading"
                               OnClick="@VerifyCode"
                               StartIcon="@Icons.Material.Filled.Verified"
                               FullWidth="true"
                               Class="login-btn mb-3">
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Processing</span>
                        }
                        else
                        {
                            <span>Verify Code</span>
                        }
                    </MudButton>

                    <MudText Typo="Typo.caption" Class="text-muted">
                        Didn't receive an @(DialogFor == "Verify Email" ? "email" : "sms")?
                        <MudLink OnClick="@(() => SentCode(DialogFor == "Verify Email" ? "SMS" : ""))"
                                 Class="text-primary cursor-pointer">
                            Try Again
                        </MudLink>
                    </MudText>
                }
            </div>
        </DialogContent>
    </MudDialog>
}

@if (DialogFor == "Two Factor Authentication")
{
    <MudDialog Class="premium-2fa-dialog pb-2">
        <DialogContent>
            <!-- Premium Professional Header -->
            <div class="premium-dialog-header">
                <div class="header-background">
                    <div class="header-content p-6 text-center">
                        <div class="icon-container mb-4 mt-2">
                            <div class="security-badge">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Class="security-icon" />
                            </div>
                            <div class="pulse-effect"></div>
                        </div>
                        <MudText Typo="Typo.h4" Class="fw-bold header-title mb-2">Two-Factor Authentication</MudText>                        
                        <div class="security-indicator">
                            <MudChip Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="security-chip">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Class="me-1" />
                                Enhanced Security Protection
                            </MudChip>
                            <MudText Typo="Typo.body1" Class="text-white text-center mb-5">
                                Choose your preferred verification method. You'll need to enter a code from this method when signing in.
                            </MudText>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dialog-content-2fa p-6">
                @if (!IsSent)
                {
                    <!-- Method Selection -->
                    <div class="method-selection">                        

                        @if (!loading)
                        {
                            <MudGrid Spacing="3">
                                <!-- Google Authenticator -->
                                <MudItem xs="12">
                                    <MudCard Class="method-card mt-2" Variant="Variant.Outlined" @onclick="@(() => SentCode("Google"))">
                                        <MudCardContent Class="pa-4">
                                            <div class="d-flex align-items-center">
                                                <MudAvatar Color="Color.Surface" Variant="Variant.Filled" Size="Size.Small" Class="me-4 method-avatar">
                                                    <MudIcon Icon="@Icons.Custom.Brands.Google" Color="Color.Primary" />
                                                </MudAvatar>
                                                <div class="flex-grow-1">
                                                    <MudText Typo="Typo.h6" Class="fw-bold mb-1">Authenticator App</MudText>
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        Use apps like Google Authenticator or Microsoft Authenticator
                                                    </MudText>
                                                </div>
                                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>

                                <!-- Email Method -->
                                <MudItem xs="12">
                                    <MudCard Class="method-card" Variant="Variant.Outlined" @onclick="@(() => SentCode("Email"))">
                                        <MudCardContent Class="pa-4">
                                            <div class="d-flex align-items-center">
                                                <MudAvatar Color="Color.Surface" Variant="Variant.Filled" Size="Size.Small" Class="me-4 method-avatar">
                                                    <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
                                                </MudAvatar>
                                                <div class="flex-grow-1">
                                                    <MudText Typo="Typo.h6" Class="fw-bold mb-1">Email Verification</MudText>
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        Receive verification codes via email
                                                    </MudText>
                                                </div>
                                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>

                                <!-- SMS Method -->
                                @if (!string.IsNullOrWhiteSpace(oModelUser.Contact))
                                {
                                    <MudItem xs="12">
                                        <MudCard Class="method-card" Variant="Variant.Outlined" @onclick="@(() => SentCode("SMS"))">
                                            <MudCardContent Class="pa-4">
                                                <div class="d-flex align-items-center">
                                                    <MudAvatar Color="Color.Surface" Variant="Variant.Filled" Size="Size.Small" Class="me-4 method-avatar">
                                                        <MudIcon Icon="@Icons.Material.Filled.Sms" Color="Color.Primary" />
                                                    </MudAvatar>
                                                    <div class="flex-grow-1">
                                                        <MudText Typo="Typo.h6" Class="fw-bold mb-1">SMS Verification</MudText>
                                                        <MudText Typo="Typo.caption" Class="text-muted">
                                                            Receive verification codes via text message
                                                        </MudText>
                                                    </div>
                                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" />
                                                </div>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                                            <div class="d-flex align-items-center">
                                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="me-2" />
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="fw-bold">SMS Verification Unavailable</MudText>
                                                    <MudText Typo="Typo.caption" Class="text-muted">
                                                        Add a mobile number to your account to enable SMS verification
                                                    </MudText>
                                                </div>
                                            </div>
                                        </MudAlert>
                                    </MudItem>
                                }
                            </MudGrid>

                            <!-- Security Info -->
                            <MudPaper Elevation="0" Class="mt-5 pa-4 security-info">
                                <div class="d-flex align-items-start">
                                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Success" Class="me-3 mt-1" />
                                    <div>
                                        <MudText Typo="Typo.body2" Class="fw-bold mb-1">Enhanced Security</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            Two-factor authentication adds an extra layer of protection to prevent unauthorized access to your account.
                                        </MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        }
                        else
                        {
                            <!-- Loading State -->
                            <div class="text-center py-6">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                                <MudText Typo="Typo.body1" Class="mt-3 text-muted">Setting up your preferred method...</MudText>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Setup Section -->
                    <div class="setup-section">
                        @if (Type == "Google")
                        {
                            <div class="text-center mb-5">
                                <MudText Typo="Typo.h5" Class="fw-bold text-primary mb-3">Setup Authenticator App</MudText>
                                <MudText Typo="Typo.body1" Class="text-muted">
                                    Scan the QR code below with your authenticator app
                                </MudText>
                            </div>

                            <MudGrid Spacing="4">
                                <MudItem xs="12" md="4">
                                    <div class="qr-container text-center">
                                        <MudPaper Elevation="8" Class="pa-3 d-inline-block rounded-lg">
                                            <MudImage Fluid="true" Src="@QRCodeURL" Alt="QR Code" Style="width: 220px; height: 220px;" />
                                        </MudPaper>
                                        <MudText Typo="Typo.caption" Class="text-muted mt-2 d-block">
                                            Scan this QR code with your app
                                        </MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                                        <MudText Typo="Typo.body2" Class="fw-bold mb-2">Can't scan the QR code?</MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            Enter this code manually in your app:
                                        </MudText>
                                        <MudPaper Elevation="2" Class="pa-3 mt-2 rounded key-Page">
                                            <MudText Typo="Typo.subtitle2" Class="fw-bold text-center text-primary font-monospace">
                                                @ManualCode
                                            </MudText>
                                        </MudPaper>
                                    </MudAlert>

                                    <div class="verification-step">
                                        <MudText Typo="Typo.body2" Class="fw-bold mb-3">Enter Verification Code</MudText>
                                        <MudTextField T="string"
                                                      @bind-Value="@OtpCode"
                                                      Mask="@(new PatternMask("000 000"))"
                                                      Label="6-digit code"
                                                      Variant="Variant.Outlined"
                                                      Required="true"
                                                      RequiredError="Please enter the 6-digit code"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.QrCode"
                                                      FullWidth="true"
                                                      Class="mb-3" />
                                    </div>
                                </MudItem>
                            </MudGrid>
                        }
                        else if (Type == "Email")
                        {
                            <div class="text-center mb-5">
                                @* <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Large" />
                                </MudAvatar> *@
                                <MudText Typo="Typo.h5" Class="fw-bold text-primary mb-2">Email Verification</MudText>
                                <MudText Typo="Typo.body1" Class="text-muted mb-3">
                                    We've sent a verification code to your email address
                                </MudText>
                                <MudChip Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mb-4">
                                    <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" Class="me-1" />
                                    @oModelUser.Email
                                </MudChip>
                            </div>

                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField T="string"
                                                  @bind-Value="@OtpCode"
                                                  MaxLength="4"
                                                  Label="4-digit verification code"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Please enter the 4-digit code"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber"
                                                  FullWidth="true" />
                                </MudItem>
                                <MudItem xs="12" Class="text-center">
                                    <MudText Typo="Typo.caption" Class="text-muted">
                                        Didn't receive the code?
                                        <MudLink OnClick="@(() => SentCode("Email"))" Class="text-primary fw-bold cursor-pointer">
                                            Resend Code
                                        </MudLink>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        }
                        else if (Type == "SMS")
                        {
                            <div class="text-center mb-5">
                                @* <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Sms" Size="Size.Large" />
                                </MudAvatar> *@
                                <MudText Typo="Typo.h5" Class="fw-bold text-primary mb-2">SMS Verification</MudText>
                                <MudText Typo="Typo.body1" Class="text-muted mb-3">
                                    We've sent a verification code to your mobile number
                                </MudText>
                                <MudChip Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mb-4">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="me-1" />
                                    @oModelUser.Contact
                                </MudChip>
                            </div>

                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField T="string"
                                                  @bind-Value="@OtpCode"
                                                  MaxLength="4"
                                                  Label="4-digit verification code"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Please enter the 4-digit code"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber"
                                                  FullWidth="true" />
                                </MudItem>
                                <MudItem xs="12" Class="text-center">
                                    <MudText Typo="Typo.caption" Class="text-muted">
                                        Didn't receive the code?
                                        <MudLink OnClick="@(() => SentCode("SMS"))" Class="text-primary fw-bold cursor-pointer">
                                            Resend Code
                                        </MudLink>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        }

                        <!-- Verification Button -->
                        <div class="text-center mt-6">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@loading"
                                       OnClick="@VerifyCode"
                                       StartIcon="@Icons.Material.Filled.VerifiedUser"
                                       Size="Size.Large"
                                       Class="verify-btn">
                                @if (loading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                    <span class="ms-2">Verifying...</span>
                                }
                                else
                                {
                                    <span>Verify & Enable 2FA</span>
                                }
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        </DialogContent>
    </MudDialog>
}

@if (DialogFor == "Disbale Two Factor Authentication")
{
    <MudDialog MaxWidth="MaxWidth.Small" Class="professional-dialog">
        <DialogContent>
            <div class="text-center p-4">
                <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" />
                </MudAvatar>

                <MudText Typo="Typo.h6" Class="fw-bold text-primary mb-2">Disable Two Factor Authentication</MudText>
                <MudText Typo="Typo.body1" Class="text-muted mb-4">
                    Two factor authentication is currently <b>Enabled</b>
                    <MudIcon Icon="@Icons.Material.Filled.ToggleOn" Color="Color.Warning" Title="Enabled" />
                </MudText>
                <MudText Typo="Typo.body2" Class="text-muted mb-4">
                    We recommend you to not disable Two factor authentication to avoid uninteded access or suspicious activity.
                    <span class="text-muted"><b>We care your security</b></span>
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Disabled="@loading"
                           OnClick="@DisableTwoFA"
                           StartIcon="@Icons.Material.Filled.ToggleOff"
                           FullWidth="true"
                           Class="login-btn">
                    @if (loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Processing</span>
                    }
                    else
                    {
                        <span>Disable 2FA</span>
                    }
                </MudButton>
            </div>
        </DialogContent>
    </MudDialog>
}