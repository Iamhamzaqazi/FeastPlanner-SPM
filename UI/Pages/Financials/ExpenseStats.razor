@page "/ExpenseStats"
@using System.ComponentModel.DataAnnotations
@using System.Globalization;
@using MudBlazor

<PageTitle>Expense Stats</PageTitle>
<AuthorizeView Roles="Expense Stats">
    <Authorized>

        <div class="dashboard-wrapper">

            <MudContainer MaxWidth="MaxWidth.False" Class="p-2">

                <!-- HEADER -->
                <MudItem xs="12" Class="mb-3">
                    <div class="dashboard-header fade-in">
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            <span class="text-primary">Expense Stats</span>
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Title="Refresh"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       @onclick="Refresh" />
                    </div>
                    @* <MudText Typo="Typo.caption" Class="text-muted mt-1">
                        You can filter Expense details as per your <b>Desired</b>
                    </MudText> *@
                    <MudDivider Class="my-2" />
                    <MudLink Class="text-muted me-1" Underline="Underline.None">Expense / </MudLink>
                    <MudLink Href="/ExpenseStats" Class="text-muted fw-bold" Underline="Underline.None">Expense Stats</MudLink>
                    <MudDivider Class="my-2" />
                </MudItem>

                <!-- FILTER FORM -->
                <MudItem xs="12" Class="mb-3">
                    <MudForm @ref="formUser" @bind-IsValid="@successUser" @bind-Errors="@errors">
                        <MudPaper Elevation="8" Class="dashboard-card animate-card p-4">
                            <MudGrid>

                                <MudItem xs="12" sm="6" md="4">
                                    <MudDateRangePicker @bind-DateRange="DateRange"
                                                        PickerVariant="PickerVariant.Inline"
                                                        DateFormat="MM/dd/yyyy"
                                                        Label="Date Range"
                                                        Variant="Variant.Outlined"
                                                        Required="true"
                                                        RequiredError="Date range required"
                                                        Adornment="Adornment.Start"
                                                        AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                                </MudItem>

                                <MudItem xs="12" sm="3" md="2">
                                    <MudButton FullWidth="true"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Disabled="@(loading)"
                                               StartIcon="@Icons.Material.Sharp.Search"
                                               OnClick="Search">
                                        @if (loading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Processing...</span>
                                        }
                                        else
                                        {
                                            <MudText>Search</MudText>
                                        }
                                    </MudButton>
                                </MudItem>

                                @if (oFilterList.Count() > 0)
                                {
                                    <MudItem xs="12" sm="3" md="2">
                                        <MudButton FullWidth="true"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(loading)"
                                                   StartIcon="@Icons.Material.Sharp.Print"
                                                   OnClick="@Refresh">
                                            Print
                                        </MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="3" md="2">
                                        <MudButton FullWidth="true"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(loading)"
                                                   StartIcon="@Icons.Material.Sharp.Cancel"
                                                   OnClick="@Refresh">
                                            Clear Filter
                                        </MudButton>
                                    </MudItem>
                                }

                            </MudGrid>
                        </MudPaper>
                    </MudForm>
                </MudItem>

                <!-- Expense STATS TABLE -->
                <MudItem xs="12" Class="mt-3">
                    <MudPaper Elevation="8" Class="dashboard-card animate-card p-4">
                        <MudTable Items="@oFilterList"
                                  Dense="true"
                                  Hover="true"
                                  Bordered="true"
                                  Striped="true"
                                  RowsPerPage="5"
                                  Elevation="0"
                                  Loading="@loading"
                                  LoadingProgressColor="Color.Primary"
                                  Filter="new Func<TrnsBusinessExpense, bool>(FilterFunc)">
                            <ToolBarContent>
                                <MudText Typo="Typo.h6">Expense Stats</MudText>
                                <MudSpacer />
                                <MudNumericField @bind-Value="oModel.Amount"
                                                 Format="N0"
                                                 HideSpinButtons="true"
                                                 Label="Total Expense"
                                                 Variant="Variant.Outlined"
                                                 ReadOnly="true"
                                                 Adornment="Adornment.Start"
                                                 AdornmentColor="Color.Primary"
                                                 AdornmentText="Rs"
                                                 FullWidth="false" />
                                <MudSpacer />
                                <MudTextField T="string"
                                              @bind-Value="searchString1"
                                              Placeholder="Search"
                                              Variant="Variant.Outlined"
                                              Clearable="true"
                                              Immediate="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              AdornmentColor="Color.Primary"
                                              FullWidth="false" />
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh Class="fw-bold">Description</MudTh>
                                <MudTh Class="fw-bold">Amount</MudTh>
                                <MudTh Class="fw-bold">Date</MudTh>
                                <MudTh Class="fw-bold">Comments</MudTh>
                                <MudTh Class="fw-bold">Added By</MudTh>
                            </HeaderContent>
                            <NoRecordsContent>
                                <MudText>No record found...</MudText>
                            </NoRecordsContent>
                            <RowTemplate Context="d1">
                                <MudTd>
                                    <MudHighlighter Text="@d1.Description" HighlightedText="@searchString1" Class="text-primary fw-bold" />
                                </MudTd>
                                <MudTd>
                                    <MudHighlighter Text="@d1.Amount.ToString("C2", CultureInfo.CreateSpecificCulture("ur-PK"))" HighlightedText="@searchString1" Class="text-primary fw-bold" />
                                </MudTd>
                                <MudTd>
                                    <MudHighlighter Text="@Convert.ToDateTime(d1.Date).ToString("MM/dd/yyyy")" HighlightedText="@searchString1" Class="text-primary fw-bold" />
                                </MudTd>
                                <MudTd>
                                    <MudHighlighter Text="@d1.Comments" HighlightedText="@searchString1" Class="text-primary fw-bold" />
                                </MudTd>
                                <MudTd>
                                    <MudHighlighter Text="@d1.AddedBy" HighlightedText="@searchString1" Class="text-primary fw-bold" />
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>

            </MudContainer>

        </div>

    </Authorized>
    <NotAuthorized>
        <NotAuthorizedPage />
    </NotAuthorized>
</AuthorizeView>