@page "/Booking"
<PageTitle>Booking | Feast Planner</PageTitle>
<MudContainer Class="mt-4 px-8 container" MaxWidth="MaxWidth.False">

    @* Hero Section *@
    <div class="metro-sitemap-hero mb-6" data-aos="fade-up">
        <div class="metro-sitemap-hero-content">
            <div class="metro-accent-line"></div>
            <MudText Typo="Typo.h1" Class="fw-bold metro-hero-title">Booking</MudText>
            <MudText Typo="Typo.body1" Class="text-muted mt-3">
                Book your events with ease and friendly user interface
            </MudText>
        </div>
    </div>
    <MudPaper Class="metro-sitemap-paper" Elevation="0">
    </MudPaper>
</MudContainer>