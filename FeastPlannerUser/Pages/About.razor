@page "/About"
@using AppDBContext.General
<PageTitle>About | Feast Planner</PageTitle>

<MudContainer Class="mt-4 px-8 container" MaxWidth="MaxWidth.ExtraExtraLarge">

    @* Hero Section with Metro Design *@
    <MudPaper Class="p-5 rounded-3" Elevation="2" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="animated-bg-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <MudGrid>
            <MudItem xs="12" sm="12" md="6" lg="6" Class="d-flex align-items-center">
