                    <div class="metro-accent-line"></div>
                    <MudText Typo="Typo.h2" Class="text-white fw-bold mb-3 metro-title animated-text">
                        About Us
                    </MudText>
                    <MudText Typo="Typo.h6" Class="text-white-50 mb-4 animated-subtitle">
                        Within the last 1 years, we have completed over 100 events
                    </MudText>
                    <MudText Typo="Typo.body1" Class="text-white-50 animated-description">
                        Successfully deployed by small businesses across Pakistan
                    </MudText>

                    <div class="mt-5 animated-buttons">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="metro-btn me-3 glow-btn">
                            Learn More
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="metro-btn-outline text-white" @onclick="GotoContactUs">
                            Contact Us
