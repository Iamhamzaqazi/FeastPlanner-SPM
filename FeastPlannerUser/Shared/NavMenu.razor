@*<MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Warning" Class="p-1 pb-5 pt-0" Href="Index" Title="Close Menu" />*@
<MudContainer Class="container-fluid text-white">
    <MudNavMenu Class="p-4 text-white">
        <div class="row text-center">
            <div class="col-sm-12">
                <div class="d-inline-flex p-3">
                    <MudNavLink Href="Index" Icon="@Icons.Material.Sharp.Home" Class="text-white p-1" IconColor="Color.Warning">Home</MudNavLink>
                    <MudNavLink Href="About" Icon="@Icons.Material.Sharp.Book" Class="text-white p-1" IconColor="Color.Warning">About</MudNavLink>
                    <MudNavLink Href="Contact" Icon="@Icons.Material.Sharp.Contacts" Class="text-white p-1" IconColor="Color.Warning">Contact</MudNavLink>
                    <MudNavLink Href="Booking" Icon="@Icons.Material.Sharp.CalendarMonth" Class="text-white p-1" IconColor="Color.Warning">Booking</MudNavLink>
                    <MudNavLink Href="Sitemap" Icon="@Icons.Material.Sharp.Tour" Class="text-white p-1" IconColor="Color.Warning">Sitemap</MudNavLink>
                </div>
            </div>
            <div class="col-sm-12">
                <marquee class="fw-bolder">Any News or Alert</marquee>
            </div>
            <div class="offset-6 col-sm-1 text-center text-white pt-3">
                <MudNavLink Href="" Style="margin-left:-40px;" title="Close menu" Class="text-white"><span class="text-white bg-dark">&nbsp; X</span></MudNavLink>
            </div>
            <div class="col-sm-12 text-center mt-5">
                <MudText Typo="Typo.caption">Follow us on</MudText><br />
                <MudIcon Class="hover-effect-About" Title="Facebook" Icon="@Icons.Custom.Brands.Facebook" Color="Color.Warning" Style="font-size: 2rem;" />
                <MudIcon Class="hover-effect-About" Title="Instagram" Icon="@Icons.Custom.Brands.Instagram" Color="Color.Warning" Style="font-size: 2rem;" />
                <MudIcon Class="hover-effect-About" Title="Twitter" Icon="@Icons.Custom.Brands.Twitter" Color="Color.Warning" Style="font-size: 2rem;" />
                <MudIcon Class="hover-effect-About" Title="Whatsapp" Icon="@Icons.Custom.Brands.WhatsApp" Color="Color.Warning" Style="font-size: 2rem;" />
                <MudText Typo="Typo.body2" Class="text-white mt-3">
                    © 2022 Feast Planner, All rights reserved. <br /> License agreement Feast Planner's<br />
                    <a href="#" class="text-decoration-underline fw-bold text-white">Terms of Service</a>
                </MudText>
            </div>
        </div>
    </MudNavMenu>
</MudContainer>